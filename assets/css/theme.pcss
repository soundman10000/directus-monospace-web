:root {
  --color-bg: var(--neutral-50);
  --color-bg-secondary: var(--neutral-100);
  --color-text: var(--neutral-900);
  --color-text-secondary: var(--neutral-600);
  --color-border: var(--neutral-200);

  --color-primary: var(--brand-primary);
  --color-primary-hover: var(--brand-primary-dark);
}

.dark {
  --color-bg: var(--neutral-950);
  --color-bg-secondary: var(--neutral-900);
  --color-text: var(--neutral-100);
  --color-text-secondary: var(--neutral-400);
  --color-border: var(--neutral-700);

  --color-primary: var(--brand-primary-light);
  --color-primary-hover: var(--brand-primary);
}